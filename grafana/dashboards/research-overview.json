{
  "uid": "research-overview",
  "title": "Manufacturing RL | Experiment Overview",
  "tags": [
    "manufacturing",
    "verified"
  ],
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "type": "query",
        "datasource": {
          "uid": "manufacturing_pg",
          "type": "grafana-postgresql-datasource"
        },
        "query": "SELECT run_id FROM research_runs ORDER BY created_at DESC",
        "definition": "SELECT run_id FROM research_runs ORDER BY created_at DESC",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0
      },
      {
        "name": "dataset",
        "type": "query",
        "datasource": {
          "uid": "manufacturing_pg",
          "type": "grafana-postgresql-datasource"
        },
        "query": "SELECT DISTINCT instance FROM evaluation_metrics WHERE run_id=${run_id:sqlstring}",
        "definition": "SELECT DISTINCT instance FROM evaluation_metrics WHERE run_id=${run_id:sqlstring}",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0
      },
      {
        "name": "method",
        "type": "query",
        "datasource": {
          "uid": "manufacturing_pg",
          "type": "grafana-postgresql-datasource"
        },
        "query": "SELECT DISTINCT method FROM evaluation_metrics WHERE run_id=${run_id:sqlstring} ORDER BY method",
        "definition": "SELECT DISTINCT method FROM evaluation_metrics WHERE run_id=${run_id:sqlstring} ORDER BY method",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 0,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "seed",
        "type": "query",
        "datasource": {
          "uid": "manufacturing_pg",
          "type": "grafana-postgresql-datasource"
        },
        "query": "SELECT DISTINCT seed FROM evaluation_metrics WHERE run_id=${run_id:sqlstring} ORDER BY seed",
        "definition": "SELECT DISTINCT seed FROM evaluation_metrics WHERE run_id=${run_id:sqlstring} ORDER BY seed",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 0,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 101,
      "title": "Run status",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "uid": "manufacturing_pg",
        "type": "grafana-postgresql-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT status,COUNT(*) AS runs FROM research_runs GROUP BY status",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 102,
      "title": "Current experiment",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "uid": "manufacturing_pg",
        "type": "grafana-postgresql-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT run_id,status,created_at,metadata->>'elapsed_s' AS elapsed_seconds,metadata->>'git_commit' AS git_commit FROM research_runs WHERE run_id=${run_id:sqlstring}",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 103,
      "title": "Evaluations and constraints",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "uid": "manufacturing_pg",
        "type": "grafana-postgresql-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT method, COUNT(*) AS evaluations, MIN(makespan) AS best_makespan, MIN(total_tardiness) AS best_tardiness, SUM(constraint_violation_count) AS violations FROM evaluation_metrics WHERE run_id=${run_id:sqlstring} AND instance=${dataset:sqlstring} AND method IN (${method:sqlstring}) AND seed IN (${seed:csv}) GROUP BY method ORDER BY method",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
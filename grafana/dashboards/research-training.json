    {
      "id": 904,
      "title": "Training throughput and checkpoint audit",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "manufacturing_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "manufacturing_pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT step,payload->>'seed' AS seed,payload->>'env_steps' AS env_steps,payload->>'training_steps_per_second' AS steps_per_second,payload->>'ram_mb' AS ram_mb,payload->>'training_time_s' AS training_time_s,payload->>'checkpoint_bytes' AS checkpoint_bytes FROM extended_records WHERE run_id=${run_id:sqlstring} AND payload->>'record_type' IN ('training','training_summary') ORDER BY step DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },

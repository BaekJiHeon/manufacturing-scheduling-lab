    },
    {
      "id": 902,
      "title": "PPO training losses \u00b7 recorded optimizer updates",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "manufacturing_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "manufacturing_pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT (payload->>'recorded_at')::timestamptz AS time,'seed '||(payload->>'seed')||' '||v.key AS metric,(v.value)::float AS value FROM extended_records CROSS JOIN LATERAL jsonb_each_text(payload) v WHERE run_id=${run_id:sqlstring} AND v.key IN ('train_policy_gradient_loss','train_value_loss','train_approx_kl') ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 903,
      "title": "PPO entropy and gradient norm",

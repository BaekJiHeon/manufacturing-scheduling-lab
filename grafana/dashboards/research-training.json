  "panels": [
    {
      "id": 900,
      "title": "PPO validation objective \u00b7 lower is better",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "manufacturing_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "manufacturing_pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT (payload->>'recorded_at')::timestamptz AS time,'seed '||(payload->>'seed') AS metric,(payload->>'objective_score')::float AS value FROM extended_records WHERE run_id=${run_id:sqlstring} AND payload->>'record_type'='validation' ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 901,
      "title": "PPO episode reward \u00b7 gamma=1 objective identity",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "manufacturing_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,

      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "manufacturing_pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT (payload->>'recorded_at')::timestamptz AS time,'seed '||(payload->>'seed') AS metric,(payload->>'train_episode_return')::float AS value FROM extended_records WHERE run_id=${run_id:sqlstring} AND payload ? 'train_episode_return' ORDER BY time"
        }
      ],

          "rawSql": "SELECT (payload->>'recorded_at')::timestamptz AS time,'seed '||(payload->>'seed')||' '||v.key AS metric,(v.value)::float AS value FROM extended_records CROSS JOIN LATERAL jsonb_each_text(payload) v WHERE run_id=${run_id:sqlstring} AND v.key IN ('train_entropy_loss','gradient_norm_before_clip') ORDER BY time"
        }
